<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chess_DB.ViewModels"
             x:Class="Chess_DB.Views.DetailsCompetitionView"
             x:DataType="vm:DetailsCompetitionViewModel"
             Background="white">

    <Grid RowDefinitions="Auto, *">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="10">
            <Button Grid.Column="0" Content="← Retour" Command="{Binding RetourCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" 
                       FontSize="20" FontWeight="Bold" Foreground="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Competition.Parties}" Margin="10" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#e8e8e8" CornerRadius="5" Padding="10" BorderBrush="#e0e0e0" BorderThickness="1">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding Coups}" Foreground="Black" />
                        </ToolTip.Tip>
                        
                        <Grid ColumnDefinitions="*, Auto, *, Auto, Auto">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Blancs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurBlanc.Nom}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurBlanc.Prenom}" Foreground="Black" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="VS" FontWeight="Bold" Foreground="#cccccc" VerticalAlignment="Center" Margin="20,0"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Noirs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurNoir.Nom}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurNoir.Prenom}" Foreground="Black" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#4285f4" CornerRadius="5" Padding="10,5" Margin="20,0,0,0">
                                <TextBlock Text="{Binding Resultat}" FontWeight="Bold" FontSize="16"/>
                            </Border>

                            <Button Grid.Column="4" 
                                    Content="📜"
                                    ToolTip.Tip="Voir la liste des coups"
                                    Background="Transparent"
                                    Command="{Binding $parent[UserControl].DataContext.AfficherCoupsCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>