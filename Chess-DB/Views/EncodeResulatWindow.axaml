<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess_DB.ViewModels"
        xmlns:conv="using:Chess_DB.Converters"
        x:Class="Chess_DB.Views.EncoderResultatWindow"
        x:DataType="vm:EncoderResultatViewModel"
        Title="Encoder le match"
        Width="450" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Foreground="Black"
        RequestedThemeVariant="Light"
        Background="WhiteSmoke">

    <Window.Resources>
        <conv:IndexToBoolConverter x:Key="IndexToBoolConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <!-- Affichage des joueurs -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="{Binding PartieEnCours.JoueurBlanc.Nom}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="VS" HorizontalAlignment="Center" Foreground="Gray"/>
            <TextBlock Text="{Binding PartieEnCours.JoueurNoir.Nom}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- encodage du gagnant -->
        <Border Grid.Row="1" Background="#fbbc04" CornerRadius="10" Margin="0,0,0,20" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <RadioButton Content="Blancs (1-0)" 
                             Foreground="Black"
                             IsChecked="{Binding SelectedResultIndex, Mode=TwoWay, Converter={StaticResource IndexToBoolConverter}, ConverterParameter='0'}"/>
                <RadioButton Content="Noirs (0-1)" 
                             Foreground="Black"
                             IsChecked="{Binding SelectedResultIndex, Mode=TwoWay, Converter={StaticResource IndexToBoolConverter}, ConverterParameter='1'}"/>
                <RadioButton Content="Nul (1/2-1/2)" 
                             Foreground="Black"
                             IsChecked="{Binding SelectedResultIndex, Mode=TwoWay, Converter={StaticResource IndexToBoolConverter}, ConverterParameter='2'}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*, 20, Auto">
            
            <!-- Historique des coups -->
            <Border Grid.Column="0" BorderBrush="#dddddd" BorderThickness="1" CornerRadius="5" Padding="0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#f5f5f5" Padding="10" CornerRadius="5,5,0,0">
                        <TextBlock Text="Historique de la partie" FontWeight="Bold" Foreground="#555555"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding ListeCoups}" Background="White" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="30, *, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Numero, StringFormat='{}{0}.'}" FontWeight="Bold" Foreground="#888888"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Blanc}" FontWeight="SemiBold" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Noir}" FontWeight="SemiBold" Foreground="Black"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Saisie nouveau coup -->
            <StackPanel Grid.Column="2" Width="200" Spacing="15">
                <TextBlock Text="Nouveau Coup" FontWeight="Bold" FontSize="16" Foreground="Black"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Blancs" FontSize="12" Foreground="Gray"/>
                    <TextBox Text="{Binding InputCoupBlanc}" 
                             Watermark="ex: e4" 
                             CornerRadius="5"
                             />
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Noirs" FontSize="12" Foreground="Gray"/>
                    <TextBox Text="{Binding InputCoupNoir}" 
                             Watermark="ex: e5" 
                             CornerRadius="5"
                             />
                </StackPanel>

                <Button Content="Ajouter le coup" 
                        Command="{Binding AjouterCoupCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#4285f4" Foreground="White" FontWeight="Bold" CornerRadius="5" Padding="10"/>

                <Button Content="Supprimer dernier" 
                        Command="{Binding SupprimerDernierCoupCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#ea4335" Foreground="White" FontSize="12" CornerRadius="5"/>
            </StackPanel>
        </Grid>

        <!-- Bouton valider et calculer ELO -->
        <Button Grid.Row="3" 
                Content="VALIDER ET CALCULER ELO" 
                Command="{Binding ValiderCommand}"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#34a853" Foreground="White" FontWeight="Bold"
                Margin="0,20,0,0"/>
    </Grid>
</Window>