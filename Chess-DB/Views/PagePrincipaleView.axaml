<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                x:Class="Chess_DB.Views.PagePrincipaleView"
                x:DataType="vm:PagePrincipaleViewModel"
                xmlns:vm="using:Chess_DB.ViewModels">

    <Grid Background="white">

        <!-- Fenêtre gestion des joueurs -->
        <StackPanel Margin="10">

            <!-- Titre -->
            <TextBlock Text="Liste des joueurs" Foreground="black" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <!-- Boutons Trier -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="Trier par Elo ↑" Command="{Binding TrierParEloCommand}" />
                <Button Content="Trier par Elo ↓" Command="{Binding TrierParEloDescCommand}" />
            </StackPanel>

            <!-- En-têtes liste -->
            <Border Background="#b3b3b3" CornerRadius="10,10,0,0">
                <Grid ColumnDefinitions="*,*,*,Auto">
                    <TextBlock Text="Nom" Padding="7" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Prénom" Padding="7" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="ELO" Padding="7" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="" Grid.Column="3" Padding="7"/>
                </Grid>
            </Border>

            <!--Liste de joueurs -->
            <ListBox ItemsSource="{Binding Joueurs}"
                    SelectedItem="{Binding SelectedJoueur, Mode=TwoWay}"
                    Margin="0,0,0,5"
                    CornerRadius="0,0,10,10"
                    >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*,*,Auto,Auto">
                            <!-- Informations sur le joueur -->
                            <TextBlock Text="{Binding Nom}" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Prenom}" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ClassementElo}" Grid.Column="2" HorizontalAlignment="Center"/>
                            
                            <!-- Bouton pour voir les statistiques du joueur -->
                            <Button Content="📊" 
                                    Grid.Column="3" 
                                    Margin="5,0"
                                    Padding="8,5" 
                                    VerticalAlignment="Center"
                                    Background="#4285f4" 
                                    Foreground="White"
                                    ToolTip.Tip="Voir les statistiques"
                                    Command="{Binding $parent[UserControl].DataContext.VoirStatsCommand}"
                                    CommandParameter="{Binding}"/>

                            <!-- Bouton pour supprimer le joueur -->
                            <Button Content="X" 
                                    Grid.Column="4" 
                                    Margin="5,0"
                                    Padding="8,5" 
                                    VerticalAlignment="Center"
                                    Background="#ea4335" 
                                    Foreground="White"
                                    ToolTip.Tip="Supprimer le joueur"
                                    Command="{Binding $parent[UserControl].DataContext.SupprimerJoueurInlineCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Boutons ajouter un joueur -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Ajouter" Command="{Binding AjouterJoueurCommand}"/>
            </StackPanel>

        </StackPanel>
        
    </Grid>
</UserControl>