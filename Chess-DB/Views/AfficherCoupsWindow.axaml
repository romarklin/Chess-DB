<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess_DB.ViewModels"
        x:Class="Chess_DB.Views.AfficherCoupsWindow"
        x:DataType="vm:AfficherCoupsViewModel"
        Title="Détails de la partie"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="White">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <TextBlock Grid.Row="0" Text="{Binding Titre}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="5" Padding="10" Background="#f8f8f8">
            <ScrollViewer>
                <TextBlock Text="{Binding TexteCoups}" 
                           TextWrapping="Wrap" 
                           FontFamily="Consolas, Monospace" 
                           FontSize="14"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Fermer" Command="{Binding FermerCommand}" 
                HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>