<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                xmlns:vm="using:Chess_DB.ViewModels"
                x:Class="Chess_DB.Views.CompetitionsView"
                x:DataType="vm:CompetitionsViewModel"
                Background="white">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="10"/>

        <!-- Nom de la compétition -->
        <Border Grid.Row="1" Background="Gray" Margin="10,0,10,0" CornerRadius="5" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Nom de la compétition :" VerticalAlignment="Center" FontWeight="SemiBold"/>
                
                <TextBox Text="{Binding NomCompetition}" 
                         Width="280" 
                         Watermark="Entrez un nom..."
                         Background="Black"/>
            </StackPanel>
        </Border>

        <!-- Liste des parties -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Parties}" Margin="10" CornerRadius="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#cccccc" BorderThickness="0,0,0,1" Padding="5">
                        <Grid ColumnDefinitions="*, Auto, *, Auto">

                            <!-- Informations sur les joueurs blancs -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="Blancs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurBlanc.Nom}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurBlanc.Prenom}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="VS" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>

                            <!-- Informations sur les joueurs noirs -->
                            <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="Noirs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurNoir.Nom}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding JoueurNoir.Prenom}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Affichage du résultat et bouton encoder -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Resultat}" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
                                
                                <Button Content="Encoder" 
                                        Background="#fbbc04" Foreground="Black"
                                        IsEnabled="{Binding PeutEncoder}"
                                        Command="{Binding $parent[UserControl].DataContext.EncoderResultatCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bouton terminer et voir historique -->
        <Button Grid.Row="3" 
                Content="Terminer la compétition et voir l'Historique" 
                Command="{Binding TerminerEtVoirHistoriqueCommand}"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#34a853" Foreground="White" FontWeight="Bold" FontSize="16"
                Padding="15" Margin="10"/>
    </Grid>
</UserControl>